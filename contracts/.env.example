# Copy this file to .env and fill in the values. Never commit the real .env file.

# Sepolia (the source chain events get presented and proven on)
SOURCE_CHAIN_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
SOURCE_CHAIN_KEY=1

# Creditcoin CC3 testnet
CREDITCOIN_RPC_URL="https://rpc.cc3-testnet.creditcoin.network"
CREDITCOIN_WALLET_PRIVATE_KEY="<your_creditcoin_and_sepolia_wallet_private_key>"

# Optional second wallet, used by demo scripts run with "--as counterparty" so the flow
# isn't one wallet playing every role. Needs a little Sepolia ETH and testnet CTC too.
COUNTERPARTY_PRIVATE_KEY=""

# Attestcoin proof builder for CC3 testnet
PROOF_BUILDER_URL="https://prover.cc3-testnet.creditcoin.network"

# Filled in after deployment (see script/README.md)
AVAL_INSTRUMENT_ADDRESS=""
AVAL_PRESENTMENT_ADDRESS=""
AVAL_COLLATERAL_VAULT_ADDRESS=""
